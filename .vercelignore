# Tidak diunggah ke Vercel (vendor dipasang ulang oleh runtime vercel-php lewat composer)
/vendor
/node_modules
/.env
/.env.*
!/.env.example
/database/*.sqlite*
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing
/storage/app/private/*
/storage/app/public/*
/bootstrap/cache/*.php
/tests
/.phpunit.cache
/.phpunit.result.cache
/demo.bat
/.github
