APP_NAME=SIPELAB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info

# Database: MySQL/MariaDB untuk production. Untuk mencoba cepat tanpa MySQL,
# ganti DB_CONNECTION=sqlite dan hapus/komentari baris DB_HOST s.d. DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipelab
DB_USERNAME=sipelab
DB_PASSWORD=

# Sesi: berakhir setelah 30 menit tidak aktif, maksimal 10 jam sejak login.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# Wajib true bila sudah memakai HTTPS
SESSION_SECURE_COOKIE=false
SIPELAB_SESSION_ABSOLUTE=600
SIPELAB_POLL_SECONDS=8

# Isi alamat IP reverse proxy/load balancer bila ada (pisahkan dengan koma)
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# Hanya untuk demo/pengembangan: buat akun contoh saat `php artisan db:seed`
SEED_DEMO=false
SEED_PASSWORD=Lab12345!
